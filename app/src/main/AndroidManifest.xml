<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stremio sirve los vídeos desde su servidor local por HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Se declara como app de TV, pero sin exigir leanback ni pantalla táctil
         para que se pueda instalar igualmente en otros dispositivos. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- usesCleartextTraffic: el servidor de Stremio es http://127.0.0.1:11470 (sin TLS). -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NightPlayer"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="landscape">

            <!-- Aparece en la fila de apps del inicio de la tele. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- "Abrir vídeo con...": así aparecemos en el selector cuando Stremio usa
                 un reproductor externo. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Listas HLS, que algunas apps envían con su propio tipo MIME. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/x-mpegURL" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>

            <!-- Variante sin tipo MIME para http/https (por si Stremio no lo indica).
                 Con esto también aparecemos como opción para abrir cualquier enlace web,
                 pero en una tele es poco habitual y Stremio lo necesita. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
